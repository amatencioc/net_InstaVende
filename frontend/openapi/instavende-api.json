        "required": [
          "isActive",
          "botName",
          "fallbackMessage",
          "enableHandoff",
          "handoffTriggerPhrase",
          "businessHours",
          "returnPolicy",
          "warrantyPolicy",
          "shippingTimes",
          "activePromotions",
          "discountLevel1",
          "discountLevel2",
          "discountLevel3",
          "maxDiscountPercent",
          "loyaltyDiscount",
          "bundleDiscount",
          "freeShippingThreshold",
          "currencySymbol",
          "hoursStatus",
          "updatedAt"
