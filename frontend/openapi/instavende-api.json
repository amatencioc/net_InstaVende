  "components": {
    "schemas": {
      "ChannelType": {
        "enum": [
          "WhatsApp",
          "FacebookMessenger",
          "Instagram"
        ]
      },
      "CustomerSegment": {
        "enum": [
          "Frio",
          "Tibio",
          "Caliente"
        ]
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "PagedResultOfReminderDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReminderDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "firstName",
          "lastName",
          "email",
          "password",
          "businessName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "maxLength": 100,
            "minLength": 8,
            "type": "string"
          },
          "businessName": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ReminderContactOptionDto": {
        "required": [
          "id",
          "name",
          "phone",
          "avatarUrl",
          "channel",
          "lastSeenAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReminderCountsDto": {
        "required": [
          "pending",
          "sent",
          "failed",
          "cancelled"
        ],
        "type": "object",
        "properties": {
          "pending": {
            "type": "integer",
            "format": "int32"
          },
          "sent": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          },
          "cancelled": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ReminderDto": {
        "required": [
          "id",
          "contactId",
          "contactName",
          "contactPhone",
          "contactAvatarUrl",
          "channel",
          "conversationId",
          "message",
          "scheduledAt",
          "status",
          "sentAt",
          "templateKey",
          "createdByName",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "contactId": {
            "type": "integer",
            "format": "int32"
          },
          "contactName": {
            "type": [
              "null",
              "string"
            ]
          },
          "contactPhone": {
            "type": [
              "null",
              "string"
            ]
          },
          "contactAvatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "conversationId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/ReminderStatus"
          },
          "sentAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "templateKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdByName": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReminderStatus": {
        "enum": [
          "Pending",
          "Sent",
          "Failed",
          "Cancelled"
        ]
      },
      "ReminderTemplateItemDto": {
        "required": [
          "order",
          "timeWindow",
          "message",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "format": "int32"
          },
          "timeWindow": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ReminderTemplateItemUpdate": {
        "required": [
          "order",
          "message",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "order": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ReminderTemplateSegmentDto": {
        "required": [
          "segment",
          "maxReminders",
          "isDefault",
          "reminders",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "segment": {
            "$ref": "#/components/schemas/CustomerSegment"
          },
          "maxReminders": {
            "type": "integer",
            "format": "int32"
          },
          "isDefault": {
            "type": "boolean"
          },
          "reminders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReminderTemplateItemDto"
            }
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ReminderTemplateSegmentUpdateRequest": {
        "required": [
          "reminders"
        ],
        "type": "object",
        "properties": {
          "reminders": {
            "maxItems": 2,
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReminderTemplateItemUpdate"
            }
          }
        }
      },
      "ReminderTemplateSuggestionDto": {
        "required": [
          "id",
          "title",
          "message",
