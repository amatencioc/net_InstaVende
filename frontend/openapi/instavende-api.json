            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReminderTemplateSegmentUpdateRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReminderTemplateSegmentUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
