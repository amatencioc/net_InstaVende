{
  "openapi": "3.1.1",
  "info": {
    "title": "InstaVende API",
    "description": "API del panel de InstaVende (vendedor IA multicanal). Autenticación por cookie + cabecera X-XSRF-TOKEN.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/dashboard": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "Metrics"
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/setup-business": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupBusinessRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupBusinessRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SetupBusinessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChannelType": {
        "enum": [
          "WhatsApp",
          "FacebookMessenger",
          "Instagram"
        ]
      },
      "ConversationStatus": {
        "enum": [
          "BotActive",
          "WaitingHuman",
          "HumanActive",
          "Resolved"
        ]
      },
      "DashboardAttentionConversationDto": {
        "required": [
          "id",
          "contactId",
          "contactName",
          "channel",
          "status",
          "lastMessagePreview",
          "lastMessageAt",
          "unreadCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "contactId": {
            "type": "integer",
            "format": "int32"
          },
          "contactName": {
            "type": "string"
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "status": {
            "$ref": "#/components/schemas/ConversationStatus"
          },
          "lastMessagePreview": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastMessageAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "unreadCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DashboardChannelDto": {
        "required": [
          "channel",
          "conversations",
          "orders",
          "revenue"
        ],
        "type": "object",
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "conversations": {
            "type": "integer",
            "format": "int32"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "revenue": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "DashboardDailyPointDto": {
        "required": [
          "date",
          "conversations",
          "orders",
          "revenue"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "conversations": {
            "type": "integer",
            "format": "int32"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "revenue": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "DashboardDto": {
        "required": [
          "generatedAt",
          "localDate",
          "today",
          "yesterday",
          "last7Days",
          "previous7Days",
          "conversationsWaitingHuman",
          "ordersInValidation",
          "daily",
          "channels",
          "recentOrders",
          "attentionConversations",
          "setup"
        ],
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "localDate": {
            "type": "string",
            "format": "date"
          },
          "today": {
            "$ref": "#/components/schemas/DashboardKpisDto"
          },
          "yesterday": {
            "$ref": "#/components/schemas/DashboardKpisDto"
          },
          "last7Days": {
            "$ref": "#/components/schemas/DashboardKpisDto"
          },
          "previous7Days": {
            "$ref": "#/components/schemas/DashboardKpisDto"
          },
          "conversationsWaitingHuman": {
            "type": "integer",
            "format": "int32"
          },
          "ordersInValidation": {
            "type": "integer",
            "format": "int32"
          },
          "daily": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardDailyPointDto"
            }
          },
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardChannelDto"
            }
          },
          "recentOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardRecentOrderDto"
            }
          },
          "attentionConversations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardAttentionConversationDto"
            }
          },
          "setup": {
            "$ref": "#/components/schemas/DashboardSetupDto"
          }
        }
      },
      "DashboardKpisDto": {
        "required": [
          "newConversations",
          "inboundMessages",
          "orders",
          "revenue",
          "averageTicket"
        ],
        "type": "object",
        "properties": {
          "newConversations": {
            "type": "integer",
            "format": "int32"
          },
          "inboundMessages": {
            "type": "integer",
            "format": "int32"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "revenue": {
            "type": "number",
            "format": "double"
          },
          "averageTicket": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "DashboardRecentOrderDto": {
        "required": [
          "id",
          "orderNumber",
          "customerName",
          "total",
          "subStatus",
          "subStatusLabel",
          "subStatusCss",
          "channel",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "orderNumber": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "subStatus": {
            "$ref": "#/components/schemas/OrderSubStatus"
          },
          "subStatusLabel": {
            "type": "string"
          },
          "subStatusCss": {
            "type": "string"
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DashboardSetupDto": {
        "required": [
          "completedSteps",
          "totalSteps",
          "percent",
          "steps"
        ],
        "type": "object",
        "properties": {
          "completedSteps": {
            "type": "integer",
            "format": "int32"
          },
          "totalSteps": {
            "type": "integer",
            "format": "int32"
          },
          "percent": {
            "type": "integer",
            "format": "int32"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardSetupStepDto"
            }
          }
        }
      },
      "DashboardSetupStepDto": {
        "required": [
          "key",
          "title",
          "description",
          "done"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "MetricsBotDto": {
        "required": [
          "botMessages",
          "humanMessages",
          "automationRate",
          "conversations",
          "handoffs",
          "handoffRate",
          "averageFirstResponseSeconds"
        ],
        "type": "object",
        "properties": {
          "botMessages": {
            "type": "integer",
            "format": "int32"
          },
          "humanMessages": {
            "type": "integer",
            "format": "int32"
          },
          "automationRate": {
            "type": "number",
            "format": "double"
          },
          "conversations": {
            "type": "integer",
            "format": "int32"
          },
          "handoffs": {
            "type": "integer",
            "format": "int32"
          },
          "handoffRate": {
            "type": "number",
            "format": "double"
          },
          "averageFirstResponseSeconds": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "MetricsChannelDto": {
        "required": [
          "channel",
          "revenue",
          "orders",
          "conversations"
        ],
        "type": "object",
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "revenue": {
            "type": "number",
            "format": "double"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "conversations": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MetricsDailyPointDto": {
        "required": [
          "date",
          "revenue",
          "orders",
          "conversations",
          "botMessages",
          "humanMessages"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "revenue": {
            "type": "number",
            "format": "double"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "conversations": {
            "type": "integer",
            "format": "int32"
          },
          "botMessages": {
            "type": "integer",
            "format": "int32"
          },
          "humanMessages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MetricsDto": {
        "required": [
          "range",
          "sales",
          "previousSales",
          "bot",
          "previousBot",
          "funnel",
          "daily",
          "channels",
          "topProductsByUnits",
          "topProductsByRevenue",
          "topCustomers",
          "subStatuses"
        ],
        "type": "object",
        "properties": {
          "range": {
            "$ref": "#/components/schemas/MetricsRangeDto"
          },
          "sales": {
            "$ref": "#/components/schemas/MetricsSalesDto"
          },
          "previousSales": {
            "$ref": "#/components/schemas/MetricsSalesDto"
          },
          "bot": {
            "$ref": "#/components/schemas/MetricsBotDto"
          },
          "previousBot": {
            "$ref": "#/components/schemas/MetricsBotDto"
          },
          "funnel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricsFunnelStepDto"
            }
          },
          "daily": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricsDailyPointDto"
            }
          },
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricsChannelDto"
            }
          },
          "topProductsByUnits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricsTopProductDto"
            }
          },
          "topProductsByRevenue": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricsTopProductDto"
            }
          },
          "topCustomers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricsTopCustomerDto"
            }
          },
          "subStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricsSubStatusDto"
            }
          }
        }
      },
      "MetricsFunnelStepDto": {
        "required": [
          "key",
          "label",
          "value"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MetricsRangeDto": {
        "required": [
          "period",
          "from",
          "to",
          "previousFrom",
          "previousTo",
          "days",
          "generatedAt"
        ],
        "type": "object",
        "properties": {
          "period": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "previousFrom": {
            "type": "string",
            "format": "date"
          },
          "previousTo": {
            "type": "string",
            "format": "date"
          },
          "days": {
            "type": "integer",
            "format": "int32"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MetricsSalesDto": {
        "required": [
          "revenue",
          "orders",
          "revenueOrders",
          "averageTicket",
          "conversations",
          "conversationsWithOrder",
          "conversionRate",
          "newContacts"
        ],
        "type": "object",
        "properties": {
          "revenue": {
            "type": "number",
            "format": "double"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "revenueOrders": {
            "type": "integer",
            "format": "int32"
          },
          "averageTicket": {
            "type": "number",
            "format": "double"
          },
          "conversations": {
            "type": "integer",
            "format": "int32"
          },
          "conversationsWithOrder": {
            "type": "integer",
            "format": "int32"
          },
          "conversionRate": {
            "type": "number",
            "format": "double"
          },
          "newContacts": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MetricsSubStatusDto": {
        "required": [
          "subStatus",
          "label",
          "css",
          "orders",
          "total"
        ],
        "type": "object",
        "properties": {
          "subStatus": {
            "$ref": "#/components/schemas/OrderSubStatus"
          },
          "label": {
            "type": "string"
          },
          "css": {
            "type": "string"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "MetricsTopCustomerDto": {
        "required": [
          "contactId",
          "name",
          "channel",
          "orders",
          "spent",
          "lastOrderAt"
        ],
        "type": "object",
        "properties": {
          "contactId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "spent": {
            "type": "number",
            "format": "double"
          },
          "lastOrderAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MetricsTopProductDto": {
        "required": [
          "productId",
          "name",
          "units",
          "revenue",
          "orders"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "units": {
            "type": "integer",
            "format": "int32"
          },
          "revenue": {
            "type": "number",
            "format": "double"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "OrderSubStatus": {
        "enum": [
          "EnValidacion",
          "EnPreparacion",
          "ListoParaEnvio",
          "Enviado",
          "Entregado",
          "Finalizado",
          "Rechazado",
          "Cancelado"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "firstName",
          "lastName",
          "email",
          "password",
          "businessName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "maxLength": 100,
            "minLength": 8,
            "type": "string"
          },
          "businessName": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        }
