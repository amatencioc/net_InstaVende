          "targetAudience",
          "rules",
          "communicationStyle",
          "salesStyle",
          "responseLength",
          "useEmojis",
          "emojiPalette",
          "useOpeningPunctuation",
          "wordsToAvoid",
          "welcomeMessage",
          "purchaseConfirmationMessage",
          "humanHandoffSituations",
          "autoPauseOnHandoff",
          "handoffMessage",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "vendorName": {
            "type": "string"
          },
          "vendorGender": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": "string"
          },
          "businessDescription": {
            "type": [
              "null",
              "string"
            ]
          },
          "targetAudience": {
            "type": [
              "null",
              "string"
            ]
          },
          "rules": {
            "type": [
              "null",
              "string"
            ]
          },
          "communicationStyle": {
            "type": [
              "null",
              "string"
            ]
          },
          "salesStyle": {
            "type": [
              "null",
              "string"
            ]
          },
          "responseLength": {
            "type": "integer",
            "format": "int32"
          },
          "useEmojis": {
            "type": "boolean"
          },
          "emojiPalette": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "useOpeningPunctuation": {
            "type": "boolean"
          },
          "wordsToAvoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "welcomeMessage": {
            "type": "string"
          },
          "purchaseConfirmationMessage": {
            "type": [
              "null",
              "string"
            ]
          },
          "humanHandoffSituations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "autoPauseOnHandoff": {
            "type": "boolean"
          },
          "handoffMessage": {
            "type": [
              "null",
              "string"
            ]
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "SellerProfileResponse": {
        "required": [
          "profile",
          "countries",
          "genders",
          "templates"
        ],
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/SellerProfileDto"
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "genders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "templates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SellerProfileTemplateDto"
            }
          }
        }
      },
      "SellerProfileTemplateDto": {
        "required": [
          "id",
          "name",
          "description",
          "communicationStyle",
          "salesStyle",
          "responseLength",
          "useEmojis",
          "emojiPalette",
          "useOpeningPunctuation"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "communicationStyle": {
            "type": "string"
          },
          "salesStyle": {
            "type": "string"
          },
          "responseLength": {
            "type": "integer",
            "format": "int32"
          },
          "useEmojis": {
            "type": "boolean"
          },
          "emojiPalette": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "useOpeningPunctuation": {
            "type": "boolean"
          }
        }
      },
      "SellerProfileUpdateRequest": {
        "required": [
          "vendorName",
          "vendorGender",
          "country",
          "businessDescription",
          "targetAudience",
          "rules",
          "communicationStyle",
          "salesStyle",
          "responseLength",
          "useEmojis",
          "emojiPalette",
          "useOpeningPunctuation",
          "wordsToAvoid",
          "welcomeMessage",
          "purchaseConfirmationMessage",
          "humanHandoffSituations",
          "autoPauseOnHandoff",
          "handoffMessage"
        ],
        "type": "object",
        "properties": {
          "vendorName": {
            "maxLength": 60,
            "minLength": 0,
            "type": "string"
          },
          "vendorGender": {
            "pattern": "^(Masculino|Femenino)$",
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": "string"
          },
          "businessDescription": {
            "maxLength": 1000,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "targetAudience": {
            "maxLength": 300,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "rules": {
            "maxLength": 2000,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "communicationStyle": {
            "maxLength": 200,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "salesStyle": {
            "maxLength": 210,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "responseLength": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "useEmojis": {
            "type": "boolean"
          },
          "emojiPalette": {
            "maxItems": 24,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "useOpeningPunctuation": {
            "type": "boolean"
          },
          "wordsToAvoid": {
            "maxItems": 50,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "welcomeMessage": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "purchaseConfirmationMessage": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "humanHandoffSituations": {
            "maxItems": 20,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "autoPauseOnHandoff": {
            "type": "boolean"
          },
          "handoffMessage": {
            "maxLength": 300,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
