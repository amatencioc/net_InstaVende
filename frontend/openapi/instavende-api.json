  "components": {
    "schemas": {
      "ChannelType": {
        "enum": [
          "WhatsApp",
          "FacebookMessenger",
          "Instagram"
        ]
      },
      "ConversationLabelDto": {
        "required": [
          "id",
          "name",
          "color",
          "conversationCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "conversationCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ConversationLabelUpsertRequest": {
        "required": [
          "name",
          "color"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "color": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          }
        }
      },
      "ConversationStatus": {
        "enum": [
          "BotActive",
          "WaitingHuman",
          "HumanActive",
          "Resolved"
        ]
      },
      "InboxAgentDto": {
        "required": [
          "id",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "InboxChangeStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ConversationStatus"
          }
        }
      },
      "InboxContactDetailDto": {
        "required": [
          "id",
          "name",
          "phone",
          "externalId",
          "avatarUrl",
          "channel",
          "firstSeenAt",
          "lastSeenAt",
          "totalPurchases",
          "totalSpent",
          "lastPurchaseAt",
          "recentOrders"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "externalId": {
            "type": "string"
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalPurchases": {
            "type": "integer",
            "format": "int32"
          },
          "totalSpent": {
            "type": "number",
            "format": "double"
          },
          "lastPurchaseAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "recentOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InboxContactOrderDto"
            }
          }
        }
      },
      "InboxContactOrderDto": {
        "required": [
          "id",
          "orderNumber",
          "status",
          "subStatus",
          "statusLabel",
          "total",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "orderNumber": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "subStatus": {
