        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean"
          },
          "botName": {
            "type": "string"
          },
          "fallbackMessage": {
            "type": "string"
          },
          "enableHandoff": {
            "type": "boolean"
          },
          "handoffTriggerPhrase": {
            "type": [
              "null",
              "string"
            ]
          },
          "businessHours": {
            "type": [
              "null",
              "string"
            ]
          },
          "returnPolicy": {
            "type": [
              "null",
              "string"
            ]
          },
          "warrantyPolicy": {
            "type": [
              "null",
              "string"
            ]
          },
          "shippingTimes": {
            "type": [
              "null",
              "string"
            ]
          },
          "activePromotions": {
            "type": [
              "null",
              "string"
            ]
          },
          "discountLevel1": {
            "type": "number",
            "format": "double"
          },
          "discountLevel2": {
            "type": "number",
            "format": "double"
          },
          "discountLevel3": {
            "type": "number",
            "format": "double"
          },
          "maxDiscountPercent": {
            "type": "number",
            "format": "double"
          },
          "loyaltyDiscount": {
            "type": "number",
            "format": "double"
          },
          "bundleDiscount": {
