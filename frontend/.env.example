# URL de la API en desarrollo (proxy de Vite). En producción el SPA llama a /api en su mismo origen
# o a VITE_API_BASE_URL si la API vive en otro subdominio del mismo sitio.
VITE_DEV_API_TARGET=http://localhost:5221
VITE_API_BASE_URL=

# Solo desarrollo: precarga el login (usar en .env.development.local, nunca en producción)
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=
