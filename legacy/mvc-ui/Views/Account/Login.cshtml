@model InstaVende.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}
<a asp-controller="Home" asp-action="Index" class="auth-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al inicio</a>
<h1 class="auth-box-title">Bienvenido de vuelta</h1>
<p class="auth-box-sub">Inicia sesión para gestionar tu vendedor IA</p>
<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="f-val-box"></div>
    <div class="f-group">
        <label asp-for="Email" class="f-label">Email</label>
        <input asp-for="Email" class="f-input" placeholder="tu@negocio.com" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="f-val-msg"></span>
    </div>
    <div class="f-group">
        <label asp-for="Password" class="f-label">Contraseña</label>
        <input asp-for="Password" class="f-input" placeholder="••••••••" autocomplete="current-password" />
        <span asp-validation-for="Password" class="f-val-msg"></span>
    </div>
    <div class="f-group">
        <label class="f-check"><input asp-for="RememberMe" /> Recordarme</label>
    </div>
    <button type="submit" class="btn-auth">Iniciar sesión</button>
</form>
<p class="auth-footer">¿No tienes cuenta? <a asp-action="Register">Crear cuenta gratis</a></p>
