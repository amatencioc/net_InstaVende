@{
    ViewData["Title"] = "Cuenta bloqueada";
    Layout = "_AuthLayout";
}
<h1 class="auth-box-title">Cuenta bloqueada temporalmente</h1>
<p class="auth-box-sub">Detectamos varios intentos fallidos de inicio de sesión. Por seguridad, tu cuenta quedó bloqueada durante unos minutos. Vuelve a intentarlo más tarde.</p>
<a asp-action="Login" class="btn-auth d-block text-center">Volver a iniciar sesión</a>
