@* Layout de las páginas de autenticación (login, registro, configuración inicial). *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — InstaVende</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
<div class="auth-root">
    <div class="auth-brand">
        <div class="auth-logo">Insta<span>Vende</span></div>
        <p class="auth-tagline">@(ViewData["Tagline"] ?? "Tu vendedor IA trabajando 24/7")</p>
        <div class="auth-features">
            @if (IsSectionDefined("Features"))
            {
                @await RenderSectionAsync("Features")
            }
            else
            {
                <div class="auth-feat">
                    <i class="bi bi-whatsapp" aria-hidden="true"></i>
                    <div><strong>Multicanal</strong><span>WhatsApp · Instagram · Facebook</span></div>
                </div>
                <div class="auth-feat">
                    <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                    <div><strong>Métricas en tiempo real</strong><span>Ventas, conversaciones y más</span></div>
                </div>
                <div class="auth-feat">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <div><strong>Panel seguro</strong><span>Tus datos y tokens cifrados</span></div>
                </div>
            }
        </div>
    </div>
    <main class="auth-form-wrap">
        <div class="auth-box">
            @RenderBody()
        </div>
    </main>
</div>
<script src="~/lib/jquery/jquery-3.7.1.min.js" asp-append-version="true"></script>
<partial name="_ValidationScripts" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
